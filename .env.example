# MONGODB_URI: MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vexapos?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vexapos?retryWrites=true&w=majority"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: llave para firmar los tokens de sesión.
# Obligatoria en producción (Vercel). Si no se define, el backend genera una y
# la guarda en la base de datos, pero definirla explícitamente es más estable.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="MY_SESSION_SECRET"

# SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD: solo para crear el primer
# administrador en una base de datos vacía. No afectan bases existentes.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
